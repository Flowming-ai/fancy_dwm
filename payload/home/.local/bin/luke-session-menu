#!/bin/sh
set -eu
choice=$(printf '%s\n' 'Cancel' 'Restart DWM' 'Input method' 'Lock' 'Hibernate' 'Log out' | dmenu -i -p 'Session') || exit 0
case "$choice" in
    'Hibernate') exec "$HOME/.local/bin/dwm-hibernate" ;;
    'Input method') exec fcitx5-config-qt ;;
    'Lock')
        if command -v xscreensaver-command >/dev/null 2>&1 && xscreensaver-command --lock; then exit 0; fi
        exec slock ;;
    'Restart DWM'|'Log out') ;;
    *) exit 0 ;;
esac
session_key=$(printf '%s' "${DISPLAY:-unknown}" | tr -c 'a-zA-Z0-9_-' '_')
pidfile="${XDG_RUNTIME_DIR:-$HOME/.local/state}/larbs-ubuntu-$session_key/dwm.pid"
[ -r "$pidfile" ] || exit 1
pid=$(cat "$pidfile")
case "$pid" in ''|*[!0-9]*) exit 1;; esac
[ "$pid" -gt 1 ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = dwm ] || exit 1
case "$choice" in
    'Restart DWM') kill -HUP "$pid" ;;
    *) confirm=$(printf '%s\n' 'Cancel' 'Log out' | dmenu -i -p 'Save your work first') || exit 0
       [ "$confirm" != 'Log out' ] || kill -TERM "$pid" ;;
esac
