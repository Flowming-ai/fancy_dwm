#!/bin/sh
set -eu
choice=$(printf '%s\n' 'Cancel / 取消' 'Restart DWM / 重载配置' 'Input method / 输入法设置' 'Lock / 锁屏' 'Hibernate / 真正休眠' 'Log out / 注销' | dmenu -i -p 'Session') || exit 0
case "$choice" in
    'Hibernate / 真正休眠') exec "$HOME/.local/bin/dwm-hibernate" ;;
    'Input method / 输入法设置') exec fcitx5-config-qt ;;
    'Lock / 锁屏')
        if command -v xscreensaver-command >/dev/null 2>&1 && xscreensaver-command --lock; then exit 0; fi
        exec slock ;;
    'Restart DWM / 重载配置'|'Log out / 注销') ;;
    *) exit 0 ;;
esac
session_key=$(printf '%s' "${DISPLAY:-unknown}" | tr -c 'a-zA-Z0-9_-' '_')
pidfile="${XDG_RUNTIME_DIR:-$HOME/.local/state}/larbs-ubuntu-$session_key/dwm.pid"
[ -r "$pidfile" ] || exit 1
pid=$(cat "$pidfile")
case "$pid" in ''|*[!0-9]*) exit 1;; esac
[ "$pid" -gt 1 ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = dwm ] || exit 1
case "$choice" in
    'Restart DWM / 重载配置') kill -HUP "$pid" ;;
    *) confirm=$(printf '%s\n' 'Cancel / 取消' 'Log out / 注销' | dmenu -i -p 'Save your work first / 先保存工作') || exit 0
       [ "$confirm" != 'Log out / 注销' ] || kill -TERM "$pid" ;;
esac
