#!/bin/sh
# Debian/Ubuntu may name the bat executable batcat.
if [ -x /usr/bin/batcat ]; then exec /usr/bin/batcat "$@"; fi
if [ -x /usr/bin/bat ]; then exec /usr/bin/bat "$@"; fi
if [ -x /usr/local/bin/bat ]; then exec /usr/local/bin/bat "$@"; fi
printf '%s\n' 'bat is missing; install the Ubuntu bat package.' >&2
exit 127
