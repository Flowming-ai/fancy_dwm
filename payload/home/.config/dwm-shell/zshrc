# Ubuntu DWM shell configuration. Personal overrides belong in ~/.zshrc.local.
# This file is sourced from a small managed block in ~/.zshrc.
[[ -o interactive ]] || return 0
[[ ${_DWM_SHELL_LOADED:-0} == 1 ]] && return 0
typeset -g _DWM_SHELL_LOADED=1
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$ZSH/custom"
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
export STARSHIP_CONFIG="$HOME/.config/starship.toml"
export BAT_CONFIG_PATH="$HOME/.config/bat/config"
typeset -U path
path=("$HOME/.local/bin" /usr/local/bin $path)
export PATH
[[ -r "$HOME/.config/fcitx5/dwm-env.sh" ]] && source "$HOME/.config/fcitx5/dwm-env.sh"
ZSH_THEME=""
zstyle ':omz:update' mode reminder
plugins=(git zsh-autosuggestions)
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=244'
# An existing personal .zshrc may already have loaded Oh My Zsh.
if (( ! $+functions[omz] )) && [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
fi
if (( ! $+functions[_zsh_autosuggest_start] )) && [[ -r "$ZSH_CUSTOM/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
    source "$ZSH_CUSTOM/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi
bindkey -e
bindkey '^[[A' up-line-or-search
bindkey '^[[B' down-line-or-search
alias ls='eza --icons'
alias ll='eza --icons --long --group-directories-first --git'
alias la='eza --icons --all --long --group-directories-first'
alias tree='eza --icons --tree'
alias cat='bat'
alias top='btop'
command -v starship >/dev/null && eval "$(starship init zsh)"
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
if [[ -t 1 && -z ${DESKTOP_FETCH_SHOWN:-} && -z ${DESKTOP_SETUP_TEST:-} ]]; then
    export DESKTOP_FETCH_SHOWN=1
    command -v fastfetch >/dev/null && fastfetch
fi
# Highlighting must load after other ZLE widgets and prompt setup.
if (( ! $+functions[_zsh_highlight] )) && [[ -r "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
    source "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
return 0
