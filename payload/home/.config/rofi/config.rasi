configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    terminal: "st";
    font: "JetBrainsMono Nerd Font Mono 14";
    matching: "fuzzy";
    drun-display-format: "{name}";
    display-drun: "Applications";
    display-run: "Commands";
    display-window: "Windows";
    sidebar-mode: true;
}
@theme "gruvbox-dark"
